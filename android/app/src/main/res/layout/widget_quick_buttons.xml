<?xml version="1.0" encoding="utf-8"?>
<!-- 원클릭 버튼 6개: 모유·분유·이유식 / 대변·소변·수면 (QuickLog) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/qb_breast" style="@style/QuickBtn" android:text="모유"/>
        <TextView android:id="@+id/qb_formula" style="@style/QuickBtn" android:text="분유"/>
        <TextView android:id="@+id/qb_solid" style="@style/QuickBtn" android:text="이유식"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/qb_poop" style="@style/QuickBtn" android:text="대변"/>
        <TextView android:id="@+id/qb_pee" style="@style/QuickBtn" android:text="소변"/>
        <TextView android:id="@+id/qb_sleep" style="@style/QuickBtn" android:text="수면"/>
    </LinearLayout>
</LinearLayout>
