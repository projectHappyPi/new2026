<?xml version="1.0" encoding="utf-8"?>
<!-- 두 번째 캡처 모양: 이름·D+ / 모유 48:14 전 / → 3:35:12 남음 / 밤잠 47:48 전 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/st_block"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/st_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/st_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"/>
        <TextView
            android:id="@+id/st_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#99FFFFFF"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/st_feed_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/st_feed_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"/>
        <Chronometer
            android:id="@+id/st_feed_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"/>
    </LinearLayout>

    <Chronometer
        android:id="@+id/st_next_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFeatureSettings="tnum"
        android:textSize="13sp"
        android:textColor="#99FFFFFF"/>

    <LinearLayout
        android:id="@+id/st_sleep_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/st_sleep_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"/>
        <Chronometer
            android:id="@+id/st_sleep_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"/>
    </LinearLayout>
</LinearLayout>
