<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/st_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:padding="16dp">

    <include layout="@layout/widget_status_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"/>

    <!-- 말로 기록 바로 열기 -->
    <ImageView
        android:id="@+id/st_mic"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:padding="6dp"
        android:contentDescription="@string/shortcut_voice_short"
        android:src="@drawable/ic_shortcut_mic"/>
</FrameLayout>
