# ============================================================
#  BebeLog(베베로그) 사진업로드 앱 — 환경변수 템플릿
#  실제 값은 .env 로 복사해서 채우고, .env 는 git 에 올리지 말 것
#  cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 1. 서버 기본
# ------------------------------------------------------------
NODE_ENV=development
APP_PORT=3000
# 앱/웹에서 접근하는 최종 주소 (Cloudflare Tunnel 도메인 또는 http://localhost:3000)
APP_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
TZ=Asia/Seoul

# ------------------------------------------------------------
# 2. 데이터베이스 (경량 스택: SQLite 파일 하나로 동작)
# ------------------------------------------------------------
# Prisma resolves sqlite `file:` URLs relative to prisma/schema.prisma, not the project root —
# `../data/...` lands this at <project root>/data/db, matching MEDIA_ROOT and friends below.
DATABASE_URL=file:../data/db/bebelog.sqlite

# ------------------------------------------------------------
# 3. 저장 경로  ★ 핵심 설정
# ------------------------------------------------------------
# 원본 파일 저장 루트. 여유 공간이 큰 드라이브/볼륨을 가리키게 한다.
MEDIA_ROOT=./data/media
# 썸네일 변환본 저장 루트 (재생성 가능, 백업 제외 가능)
VARIANT_ROOT=./data/variants
# 업로드 중 청크 임시 폴더 (재부팅 시 비워도 무방)
TEMP_UPLOAD_ROOT=./data/tmp
# 휴지통 파일 이동 경로 (soft delete 시 실제 파일은 여기로 이동)
TRASH_ROOT=./data/trash

# ------------------------------------------------------------
# 4. 디스크 용량 / 스토리지 3단계 임계치
# ------------------------------------------------------------
# 용량 계산 기준이 되는 마운트 지점. MEDIA_ROOT 와 같은 볼륨 위의 경로여야 정확하다.
STORAGE_CHECK_PATH=./data

# 디스크 전체 용량을 수동으로 고정하고 싶을 때만 사용 (바이트). 비워두면 실제 디스크 결과 사용.
STORAGE_TOTAL_BYTES_OVERRIDE=
# 서비스가 쓸 수 있는 최대 용량 상한 (바이트). 비워두면 디스크 전체를 상한으로 본다.
STORAGE_QUOTA_BYTES=

STORAGE_WARN_PERCENT=80
STORAGE_ALERT_PERCENT=90
STORAGE_BLOCK_PERCENT=95

# 용량 점검 배치 주기 (cron 표현식). 기본 매시 정각
STORAGE_CHECK_CRON=0 * * * *
# 동일 단계 알림을 반복 발송하지 않는 최소 간격 (시간)
STORAGE_ALERT_COOLDOWN_HOURS=24
# 캐시된 storage level TTL (초). 원래 Redis TTL 대응, 경량 스택에서는 인메모리 캐시로 대체
STORAGE_LEVEL_CACHE_TTL_SECONDS=60
# 업로드 차단 판단 시 남겨둘 최소 여유분 (바이트). 기본 1GB
STORAGE_MIN_FREE_BUFFER_BYTES=1073741824

# ------------------------------------------------------------
# 5. 업로드 정책
# ------------------------------------------------------------
UPLOAD_MAX_FILE_BYTES=5368709120      # 단일 파일 최대 5GB
UPLOAD_MAX_BATCH_COUNT=100            # 한 번에 선택 가능한 최대 개수
ALLOWED_MIME=image/jpeg,image/png,image/heic,image/heif,image/webp,video/mp4,video/quicktime

# ------------------------------------------------------------
# 6. 미디어 처리
# ------------------------------------------------------------
THUMB_SIZES=200,800,1600              # WebP 썸네일 가로 픽셀
KEEP_ORIGINAL=true                    # false 면 변환 후 원본 삭제(용량 절약)

# ------------------------------------------------------------
# 7. 인증
# ------------------------------------------------------------
# openssl rand -hex 32 로 생성
JWT_SECRET=                 # ★
JWT_ACCESS_EXPIRES_MIN=43200          # 30일(분 단위, 경량 스택은 단일 세션 토큰 사용)

# 카카오 로그인 / 공유 — 값이 비어있으면 해당 기능은 자동으로 비활성화된다 (로컬 이메일 로그인만 동작)
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# 이 카카오 ID 또는 이메일로 로그인한 계정을 관리자(role=admin)로 자동 승격
ADMIN_KAKAO_IDS=
ADMIN_EMAILS=                         # ★ 최소 1개 권장. 쉼표 구분

ADMIN_ALERT_EMAIL=          # ★ 스토리지 경고 수신 주소

# ------------------------------------------------------------
# 8. 초대 / 로그 / 휴지통
# ------------------------------------------------------------
INVITE_DEFAULT_EXPIRE_DAYS=7
INVITE_DEFAULT_MAX_USES=10
INVITE_TOKEN_LENGTH=16

ACCESS_LOG_RETENTION_DAYS=90
TRASH_RETENTION_DAYS=30
PURGE_CRON=0 4 * * *              # 매일 새벽 4시 물리 삭제

# ------------------------------------------------------------
# 9. 메일 (참여 신청 · 스토리지 경고) — 비워두면 콘솔 로그로 대체
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=              # Gmail 은 앱 비밀번호 사용
MAIL_FROM=BebeLog <noreply@bebelog.example.com>

# ------------------------------------------------------------
# 10. 카카오톡 공유
# ------------------------------------------------------------
SHARE_COVER_IMAGE_URL=http://localhost:3000/static/share-cover.png
SHARE_ENABLED=true
